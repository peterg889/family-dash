# Copy to .env.local for local development. In production these live in the
# Vercel project's environment variables — never in the repo.

# Where drives start. Only ever sent to Google (to measure drive times); it is
# not in the API response or the page.
HOME_ADDRESS=

# Drive times: a Google Cloud API key with the Routes API enabled (and billing
# on the project). Each destination is re-measured about every 5 minutes during
# DRIVE_LIVE_HOURS (New York hours, default 6-8) — 72 calls a day at most — and
# the latest measurement is shown the rest of the day. Without a working key
# there are no drive times, and the screens say so.
GOOGLE_MAPS_API_KEY=
# DRIVE_LIVE_HOURS=6-8

# Optional: NJ Transit real-time data (developer.njtransit.com RailData API).
NJT_API_USERNAME=
NJT_API_PASSWORD=
