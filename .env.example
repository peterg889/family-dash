# Copy to .env.local for local development. In production these live in the
# Vercel project's environment variables — never in the repo.

# Where drives start. Only ever sent to Google (for live traffic); it is not in
# the API response or the page.
HOME_ADDRESS=

# Typical drive time in minutes per destination — what the "leave by" times use
# whenever live traffic isn't available or isn't being asked for.
# Keys: 92 = Morristown station, 18 = Bernardsville station, commute = school run.
DRIVE_TYPICAL_MIN=92=16,18=10,commute=15

# Optional: live traffic. A Google Cloud API key with the Routes API enabled.
# Asked at most once per destination per 10 minutes, and only during
# DRIVE_LIVE_HOURS (New York hours, default 5-11) — about 100 calls a day at most.
GOOGLE_MAPS_API_KEY=
# DRIVE_LIVE_HOURS=5-11

# Optional: NJ Transit real-time data (developer.njtransit.com RailData API).
NJT_API_USERNAME=
NJT_API_PASSWORD=
